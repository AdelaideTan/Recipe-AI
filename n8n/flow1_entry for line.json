      "parameters": {
        "jsCode": "// JS 版本 (功能與你的 Python 完全一致)\nconst items = $input.all();\nconst input_data = items[0].json.body || {};\nconst events = input_data.events || [];\nlet output = [];\n\nif (events.length > 0) {\n    const event = events[0];\n    output.push({\n        json: {\n            replyToken: event.replyToken,\n            user_input: event.message?.type === \"text\" ? event.message.text : \"\",\n            event_data: event.postback?.data || \"\",\n            messageType: event.type\n        }\n    });\n}\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
