    {
      "parameters": {
        "jsCode": "const inputJson = items[0].json; \nconst replyToken = inputJson.replyToken;\n\n// 1. 確保正確讀取 event_data 變數\nlet postbackData = inputJson.event_data; \n\n// --- 檢查：確保變數存在且非空 ---\nif (!postbackData || typeof postbackData !== 'string' || postbackData.trim() === '') {\n    // 這是上游節點（Python）的問題，如果走到這裡，表示 event_data 是空的\n    const keys = Object.keys(inputJson).join(', ');\n    return [{\n        json: {\n            replyToken: replyToken,\n            messages: [{\n                \"type\": \"text\",\n                \"text\": `【解析失敗：Postback 數據不存在】\\n收到的欄位有：${keys}\\n請確認 Python 節點是否輸出 \"event_data\"。`\n            }]\n        }\n    }];\n}\n\n// 2. 開始手動解析查詢字串 (action=value&key=value)\nlet parsedParams = {};\n\ntry {\n    // 將字串依據 '&' 分割成陣列，例如: [\"action=get_ingredients\", \"recipe_url=...\"]\n    postbackData.split('&').forEach(pair => {\n        // 將每個 pair 依據 '=' 分割成 key 和 value\n        const parts = pair.split('=');\n        if (parts.length === 2) {\n            const key = parts[0].trim();\n            // 使用 decodeURIComponent 解碼 URL 編碼的值，避免中文或特殊符號亂碼\n            const value = decodeURIComponent(parts[1].trim().replace(/\\+/g, ' '));\n            parsedParams[key] = value;\n        }\n    });\n} catch (e) {\n    return [{\n        json: {\n            replyToken: replyToken,\n            messages: [{\n                \"type\": \"text\",\n                \"text\": `【解析失敗：手動處理字串錯誤】\\n錯誤訊息：${e.message}`\n            }]\n        }\n    }];\n}\n\n\n// 3. 提取所需的變數\nconst recipeUrl = parsedParams.recipe_url;\nconst action = parsedParams.action;\n\n\n// 4. 成功輸出\nif (recipeUrl && action === 'get_ingredients') {\n    return [{\n        json: {\n            replyToken: replyToken,\n            postback_action: action,\n            recipe_url: recipeUrl // recipeUrl 已經在步驟 2 中解碼\n        }\n    }];\n} else {\n    // 如果解析出來的值不符合預期\n     return [{\n        json: {\n            replyToken: replyToken,\n            messages: [{\n                \"type\": \"text\",\n                \"text\": `【解析失敗：數據不符合預期】\\nAction: ${action}, Recipe URL: ${recipeUrl}`\n            }]\n        }\n    }];\n}"
      },
